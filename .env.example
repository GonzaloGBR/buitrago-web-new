# Base de datos (desarrollo con docker-compose: puerto 3307)
DATABASE_URL="mysql://buitrago:buitrago@127.0.0.1:3307/buitrago"

# Panel admin: contraseña única + JWT firmado
ADMIN_PASSWORD="cambiar-en-produccion"
ADMIN_SESSION_SECRET="minimo-16-caracteres-seguros"

# Cloudflare R2 (opcional en dev: si falta, las subidas van a public/uploads)
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="buitrago-media"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
# Mismo valor que R2_PUBLIC_URL — necesario para URLs de imágenes en componentes cliente (hero, moodboard, logo).
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Hostname del bucket/CDN para optimización de imágenes Next (sin protocolo)
# Debe coincidir con el host de R2_PUBLIC_URL
R2_PUBLIC_HOST="media.tu-dominio.com"
